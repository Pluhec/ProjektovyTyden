MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1540256588}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 457c90f29afc4417a3523e18e20248d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OutroController
  overlayCanvasGroup: {fileID: 1834493559}
  textComponent: {fileID: 37029082}
  videoPlayer: {fileID: 1856143710}
  winVideo: {fileID: 32900000, guid: 313ee58b77db94f03ba03bda0ddf9478, type: 3}
  loseVideo: {fileID: 32900000, guid: 9e8487dd0fb08d749890885b43ae175e, type: 3}
  fadeDuration: 1
  displayDuration: 2
  winMessages:
  - "Odpor v Per\xE9nu utichl a ulice zaplnilo jednotn\xE9 skandov\xE1n\xED. Emanuel
    Verdi shl\xED\u017E\xED z ob\u0159\xEDch obrazovek na n\xE1rod, kter\xFD v poslu\u0161nosti
    na\u0161el sv\u016Fj \u201Eklid\u201C. Historie byla p\u0159eps\xE1na dne\u0161n\xEDmi
    novinami a proces mutace spole\u010Dnosti v jedin\xFD ovl\xE1dan\xFD organismus
    byl dokon\u010Den. V\xEDt\u011Bzstv\xED ideologie je absolutn\xED, proto\u017Ee
    u\u017E neexistuje nikdo, kdo by si pamatoval jin\xFD sv\u011Bt."
  - "<i>\u201EV\xE1lka je m\xEDr. Svoboda je otroctv\xED. Nev\u011Bdomost je s\xEDla.\u201C</i>\n"
  - "V\xEDtejte v \xE9\u0159e Verdiho. V\xEDtejte v dokonal\xE9m Per\xE9nu.\n"
  loseMessages:
  - "Symboly moci jsou strh\xE1v\xE1ny z pr\u016F\u010Del\xED budov a Emanuel Verdi
    u\u017E nestoj\xED na \u0159e\u010Dni\u0161ti, ale v prosklen\xE9m boxu soudn\xED
    s\xEDn\u011B. Per\xE9n se probouz\xED z noci, ve kter\xE9 byla pravda trestn\xFDm
    \u010Dinem. Soudn\xED proces s b\xFDval\xFDm v\u016Fdcem je jasn\xFDm vzkazem:
    \u017E\xE1dn\xE1 propaganda nedok\xE1\u017Ee nav\u017Edy uml\u010Det touhu \u010Dlov\u011Bka
    po svobod\u011B. Per\xE9n za\u010D\xEDn\xE1 znovu, s v\u011Bdom\xEDm, jak snadn\xE9
    je o ni p\u0159ij\xEDt."
  onOutroFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1184975740}
        m_TargetAssemblyTypeName: CreditsScroller, Assembly-CSharp
        m_MethodName: PlayCredits
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
