MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1301225821}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d30b8fa125754008adaf1dcd29d3b476, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroController
  backgroundCanvasGroup: {fileID: 1301225823}
  textComponent: {fileID: 1528463064}
  fadeDuration: 1
  displayDuration: 5
  messages:
  - "Vstupujete do simulace, kter\xE1 zkoum\xE1 hranice lidsk\xE9 svobody a moci.
    Aby byla tato zku\u0161enost autentick\xE1, setk\xE1te se s n\xE1zory a postupy,
    kter\xE9 jsou v p\u0159\xEDm\xE9m rozporu s demokratick\xFDmi principy."
  - "Berte pros\xEDm na v\u011Bdom\xED, \u017Ee tato hra striktn\u011B odm\xEDt\xE1
    a odsuzuje jakoukoli formu totality. Ve\u0161ker\xFD obsah je zde uveden pouze
    pro demonstraci psychologick\xFDch a spole\u010Densk\xFDch mechanism\u016F."
  - "M\xE9 milovan\xE9 Candy,\n\nve\u0161ker\xE9 postavy, n\xE1zvy instituc\xED a
    ud\xE1losti jsou fiktivn\xED. Jak\xE1koliv podobnost se skute\u010Dn\xFDmi osobami
    (\u017Eiv\xFDmi i zesnul\xFDmi) nebo historick\xFDmi ud\xE1lostmi je \u010Dist\u011B
    n\xE1hodn\xE1."
  - "Hern\xED mechanismy t\xE9to hry jsou p\u0159\xEDmo inspirov\xE1ny principy popul\xE1rn\xED
    hry Plague Inc."
  - "Cel\xFD n\xE1pad pramen\xED z hlavy Ing. Viktora Vr\xE1bl\xEDka."
  onIntroFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1205990605}
        m_TargetAssemblyTypeName: MainMenuController, Assembly-CSharp
        m_MethodName: BackToGame
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
