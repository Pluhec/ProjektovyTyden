#pragma kernel SimulationInit
#pragma kernel SimulationStep

struct Npc
{
    uint population;          // 0 - 255                static
    uint age;                 // 0 - 255                static
    uint education;           // 0 - 255                static
    uint impressionability;   // 0 - 255                static
    int stance;               // -128 - 127             variable
    uint friendIndex;         // friend index           static
    uint neighbors;           // 0 - 8 neighbors        static
};

Texture2D<float4> simumlationInitialTexture; // X=population, Y=age, Z=education, W=mask
int2 imageSize;
uint seedValue;

RWByteAddressBuffer npcs;
uint _NumNPCs;
int2 populationSize;
float _InternetWeight = 1.0;
int _SimulationDay;

float _ViralityYoung;
float _ImpactYoung;
float _VisibilityYoung;

float _ViralityAdults;
float _ImpactAdults;
float _VisibilityAdults;

float _ViralitySeniors;
float _ImpactSeniors;
float _VisibilitySeniors;

float _PropagandaDirection;
int _YoungMaxAge;
int _AdultMaxAge;

float Hash(uint s, bool saturate = false)
{
    s += seedValue;
    s = (s ^ 61u) ^ (s >> 16u);
    s *= 9u;
    s = s ^ (s >> 4u);
    s *= 0x27d4eb2du;
    s = s ^ (s >> 15u);
    return saturate ? float(s) / 4294967296.0 : float(s);
}

float NormalizeLevel(float value)
{
    return 1.0 - exp(-max(value, 0.0) * 0.15);
}

void GetAgeBandPropaganda(uint age, out float virality, out float impact, out float visibility)
{
    uint youngMaxAge = (uint)max(_YoungMaxAge, 0);
    uint adultMaxAge = (uint)max(_AdultMaxAge, _YoungMaxAge);

    if (age <= youngMaxAge)
    {
        virality = _ViralityYoung;
        impact = _ImpactYoung;
        visibility = _VisibilityYoung;
    }
    else if (age <= adultMaxAge)
    {
        virality = _ViralityAdults;
        impact = _ImpactAdults;
        visibility = _VisibilityAdults;
    }
    else
    {
        virality = _ViralitySeniors;
        impact = _ImpactSeniors;
        visibility = _VisibilitySeniors;
    }
}
// Load the NPC buffer
Npc LoadNpc(uint index)
{
    uint address = index * 12;
    uint3 data = npcs.Load3(address);
    Npc npc;
    npc.population = int((data.x >> 0) & 0xFF);            // Extract byte 0
    npc.age = (data.x >> 8) & 0xFF;                        // Extract byte 1
    npc.education = (data.x >> 16) & 0xFF;                 // Extract byte 2
    npc.impressionability = (data.x >> 24) & 0xFF;         // Extract byte 3
    npc.stance = int((data.y >> 0) & 0xFF) - 128;          // Extract byte 4
    npc.friendIndex = (data.y >> 8);                       // Extract bytes 5-8 (3 bytes from data.y)
    npc.friendIndex |= (data.z & 0xFF) << 24;              // Extract byte 8 (1 byte from data.z)
    npc.neighbors = (data.z >> 8) & 0xFF;                  // Extract byte 9
    // Bytes 10-11 are padding, ignored
    return npc;
}
// Store the NPC buffer
void StoreNpc(uint index, Npc npc)
{
    uint address = index * 12;
    uint3 data;
    data.x = ((npc.population) & 0xFF) | 
             ((npc.age & 0xFF) << 8) | 
             ((npc.education & 0xFF) << 16) | 
             ((npc.impressionability & 0xFF) << 24);
    data.y = ((npc.stance + 128) & 0xFF) | 
             ((npc.friendIndex & 0xFFFFFF) << 8);                       // Lower 3 bytes of friendIndex in bytes 5-7
    data.z = (npc.friendIndex >> 24) | ((npc.neighbors & 0xFF) << 8);   // Upper byte of friendIndex in byte 8, neighbors in byte 9, bytes 10-11 are padding
    npcs.Store3(address, data);
}

[numthreads(64, 1, 1)]
void SimulationInit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _NumNPCs) return;
    float2 uv = float2(id.x % populationSize.x, id.x / populationSize.x) / float2(populationSize);
    float4 initData = simumlationInitialTexture.Load(int3(uv * imageSize, 0));
    Npc npc = LoadNpc(id.x);
    npc.population = uint((initData.x - 0.05) * 260.0); // somehow normalized to match the texture
    npc.age = uint(initData.y * 255.0);
    npc.education = uint(initData.z * 255.0);
    npc.impressionability = uint(initData.w * 255.0);
    npc.stance = int(pow(saturate(initData.z*0.9 + 0.08 - Hash(id.x+789, true)*0.15), 0.2) * 255 - 128);
    npc.neighbors = uint(npc.population / 255. * 4.5 + Hash(id.x+123, true)*4); // neighbors based by population with 50% randomness
    StoreNpc(id.x, npc);
}

[numthreads(64, 1, 1)]
void SimulationStep(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _NumNPCs) return;
    Npc currentNpc = LoadNpc(id.x);
    if (currentNpc.population == 0u) return;
    int2 currentNpcPos = int2(id.x % populationSize.x, id.x / populationSize.x);

    // --- NPC traits ---
    float currentStanceF = float(currentNpc.stance);
    float stanceNorm    = clamp(currentStanceF / 127.0, -1.0, 1.0);   // -1..1
    float conviction    = saturate(pow(abs(stanceNorm), 1.2));          // how extreme
    float density       = currentNpc.population / 255.0;
    float impress       = currentNpc.impressionability / 255.0;
    float eduResist     = currentNpc.education / 255.0;
    float openness      = impress * (1.0 - 0.5 * eduResist);           // personal openness to change

    // --- Propaganda levels for this age band ---
    float viralityRaw, impactRaw, visibilityRaw;
    GetAgeBandPropaganda(currentNpc.age, viralityRaw, impactRaw, visibilityRaw);
    float virality   = NormalizeLevel(viralityRaw);
    float impact     = NormalizeLevel(impactRaw);
    float visibility = NormalizeLevel(visibilityRaw);

    // --- RNG for this NPC this day ---
    uint rng = (uint)Hash(id.x + uint(_SimulationDay) * 977u);

    // ============================================================
    //  PHASE 1 : Gather local neighbor opinions
    // ============================================================
    float localSum       = 0.0;
    float localWeight    = 0.0;
    float strongStance   = currentStanceF;   // loudest neighbor
    float strongConv     = 0.0;
    int   agreeSame      = 0;                // neighbors on my side
    int   agreeOppose    = 0;                // neighbors on other side
    int   propAligned    = 0;                // neighbors aligned with propaganda direction
    int   activeNeighbors= 0;
    float propDirSign    = sign(clamp(_PropagandaDirection, -1.0, 1.0));

    if (currentNpc.neighbors > 0) {
        int neighborOrder[8] = {0, 1, 2, 3, 4, 5, 6, 7};
        for (int j = 7; j > 0; j--) {
            rng = rng * 747796405u + 2891336453u;
            int sw = int((rng >> 16) % uint(j + 1));
            int tmp = neighborOrder[j]; neighborOrder[j] = neighborOrder[sw]; neighborOrder[sw] = tmp;
        }
        int numN = min(currentNpc.neighbors, 8u);
        for (int i = 0; i < numN; i++) {
            int ni = neighborOrder[i];
            uint mi = ni < 4 ? ni : ni + 1;
            int2 nPos = currentNpcPos + int2((mi % 3) - 1, (mi / 3) - 1);
            if (nPos.x < 0 || nPos.y < 0 || nPos.x >= populationSize.x || nPos.y >= populationSize.y) continue;
            Npc nn = LoadNpc(nPos.y * populationSize.x + nPos.x);
            if (nn.population == 0u) continue;

            float ns  = float(nn.stance);
            float nsN = ns / 127.0;
            float nc  = saturate(pow(abs(nsN), 1.2));

            // Louder neighbors (higher conviction) carry more weight
            float w = (0.3 + 0.7 * nc) * (0.4 + 0.6 * openness);
            localSum    += ns * w;
            localWeight += w;
            activeNeighbors++;

            // Track agreement / opposition relative to self
            if (stanceNorm * nsN > 0.0)   agreeSame++;
            else if (abs(nsN) > 0.08)     agreeOppose++;

            // Track alignment with propaganda direction
            if (propDirSign * nsN > 0.05) propAligned++;

            // Loudest voice
            if (nc > strongConv) { strongConv = nc; strongStance = ns; }
        }
    }

    // ============================================================
    //  PHASE 2 : Internet / Friend influence  (dedicated path)
    //            Always active — friend stance is directly blended
    //            into NPC opinion as a separate force, not just
    //            mixed into neighbor average where it gets drowned.
    // ============================================================
    float friendPull    = 0.0;   // direct stance pull from friend
    float friendActive  = 0.0;   // 1 if friend contacted this day
    Npc friendNpc = LoadNpc(min(currentNpc.friendIndex, _NumNPCs - 1));
    if (friendNpc.population > 0u) {
        float fs  = float(friendNpc.stance);
        float fsN = fs / 127.0;
        float fc  = saturate(pow(abs(fsN), 1.2));

        // Contact chance: base internet usage + conviction (loud posters)
        // + virality (algorithm boost). Independent of propaganda.
        rng = rng * 747796405u + 2891336453u;
        float fRoll = float(rng) / 4294967296.0;
        float contactChance = saturate(0.18 + 0.30 * fc + 0.30 * virality);

        if (fRoll < contactChance) {
            friendPull   = fs;
            friendActive = 1.0;
            activeNeighbors++;

            // Also feed into local tracking for echo/contagion awareness
            if (fc > strongConv) { strongConv = fc; strongStance = fs; }
            if (propDirSign * fsN > 0.05) propAligned++;
        }
    }

    // ============================================================
    //  PHASE 3 : Social dynamics + organic drift
    // ============================================================
    float nextStance = currentStanceF;

    // --- Organic drift: even without propaganda, people are not
    //     perfectly static. Small random daily fluctuations create
    //     natural opinion gradients that cascade over time. ---
    rng = rng * 747796405u + 2891336453u;
    float driftRoll = float(rng) / 4294967296.0;
    float driftAmount = (driftRoll - 0.5) * 2.0;  // -1..1
    // More impressionable / less educated people drift more
    // Moderates drift more than extremists (extremists are "locked in")
    float driftScale = (0.3 + 0.7 * impress) * (1.0 - 0.6 * eduResist) * (1.0 - conviction * 0.7);
    nextStance += driftAmount * driftScale * 1.5;

    if (activeNeighbors > 0 && localWeight > 0.0) {
        float localAvg  = localSum / localWeight;
        float localNorm = clamp(localAvg / 127.0, -1.0, 1.0);

        // --- Echo chamber: surrounded by same-side = reinforcement ---
        float agreeRatio = float(agreeSame) / float(activeNeighbors);
        float echoStrength = saturate((agreeRatio - 0.45) * 2.5);

        // --- Social pressure: surrounded by opposition = pressure to shift ---
        float opposeRatio = float(agreeOppose) / float(activeNeighbors);
        float socialPressure = saturate((opposeRatio - 0.25) * 2.0);

        // A) Gentle averaging toward local mean
        //    Stronger for open/moderate NPCs, weaker for extremists
        float avgBlend = lerp(0.04, 0.16, openness) * (1.0 - 0.55 * conviction);
        // Social pressure pushes harder toward the local average
        avgBlend *= (1.0 + socialPressure * 0.6);
        nextStance = lerp(nextStance, localAvg, avgBlend);

        // B) Echo chamber: pushes you further in your current direction
        //    Only fires when clear majority agrees with you
        if (echoStrength > 0.0 && abs(stanceNorm) > 0.04) {
            float reinforce = echoStrength * lerp(0.4, 1.8, openness) * (1.0 - conviction * 0.65);
            nextStance += sign(stanceNorm) * reinforce;
        }

        // C) Contagion: loudest voice pulls moderates toward it
        //    Only works when they're more extreme than you
        float convDiff = strongConv - conviction;
        if (convDiff > 0.08) {
            float contagion = convDiff * openness * lerp(0.05, 0.18, max(virality, 0.15));
            nextStance = lerp(nextStance, strongStance, contagion);
        }
    }

    // --- Direct friend influence (separate from local averaging) ---
    //     This is the key internet mechanic: your friend's opinion
    //     directly pulls you, weighted by internet weight and your
    //     openness. Not drowned by local neighbors.
    if (friendActive > 0.5) {
        float stanceDiff   = friendPull - nextStance;
        float diffNorm     = abs(stanceDiff) / 254.0;
        // Pull strength: internet weight * openness, stronger when
        // friend is far from you (novel viewpoint is compelling),
        // but resisted by conviction on opposite side
        float sameSide     = (sign(friendPull) == sign(nextStance)) ? 1.0 : 0.0;
        float friendResist = (1.0 - sameSide) * conviction * 0.6;
        float pullStrength = _InternetWeight * openness * (0.06 + 0.12 * diffNorm) * (1.0 - friendResist);
        pullStrength = saturate(pullStrength);
        nextStance = lerp(nextStance, friendPull, pullStrength);
    }

    // ============================================================
    //  PHASE 4 : Propaganda  (non-uniform, social-proof driven)
    // ============================================================
    {
        rng = rng * 747796405u + 2891336453u;
        float pRoll = float(rng) / 4294967296.0;

        // Spatial variation: different areas see propaganda on different days
        // Uses grid position mixed with day for slow-moving "exposure wave"
        rng = rng * 747796405u + 2891336453u;
        float spatialVar = float(rng) / 4294967296.0;

        // Exposure chance depends on:
        //  - visibility (how much propaganda is deployed)
        //  - density (cities get more media saturation)
        //  - spatial variation (not everyone at once)
        float exposureChance = visibility * (0.10 + 0.30 * spatialVar + 0.15 * density);

        if (pRoll < exposureChance)
        {
            float propTarget = clamp(_PropagandaDirection, -1.0, 1.0) * 127.0;
            float propNorm   = clamp(_PropagandaDirection, -1.0, 1.0);

            // Social proof: if local neighbors already lean toward propaganda,
            // it feels more legitimate and is more persuasive
            float socialProof = 0.0;
            if (activeNeighbors > 0)
                socialProof = saturate(float(propAligned) / float(activeNeighbors));

            // Resistance: opposing side + education + existing conviction
            float oppositeSide = saturate(max(0.0, -stanceNorm * propNorm));
            float resistance   = saturate(oppositeSide * conviction * 0.75 + eduResist * conviction * 0.5);

            // Propaganda strength: impact * openness * (1-resistance) * boosted by social proof
            float propEff  = impact * (0.3 + 0.7 * openness) * (1.0 - resistance);
            propEff *= (0.5 + 0.8 * socialProof);  // social proof amplifies up to 1.3x
            float propBlend = saturate(0.01 + propEff * 0.22);
            nextStance = lerp(nextStance, propTarget, propBlend);
        }
    }

    // ============================================================
    //  PHASE 5 : Stabilization
    // ============================================================
    // Cap daily shift: virality and density widen the cap
    float maxShift = lerp(2.5, 16.0, saturate(max(virality, impact) * 0.6 + density * 0.4));
    float delta = clamp(nextStance - currentStanceF, -maxShift, maxShift);
    nextStance = currentStanceF + delta;

    currentNpc.stance = clamp(int(round(nextStance)), -128, 127);
    StoreNpc(id.x, currentNpc);
}
