#pragma kernel SimulationInit
#pragma kernel SimulationStep

struct Npc
{
    uint population;          // 0 - 255                static
    uint age;                 // 0 - 255                static
    uint education;           // 0 - 255                static
    uint impressionability;   // 0 - 255                static
    int stance;               // -128 - 127             variable
    uint friendIndex;         // friend index           static
    uint neighbors;           // 0 - 8 neighbors        static
};

Texture2D<float4> simumlationInitialTexture; // X=population, Y=age, Z=education, W=mask
int2 imageSize;
uint seedValue;

RWByteAddressBuffer npcs;
uint _NumNPCs;
int2 populationSize;
float _InternetWeight = 1.0;
int _SimulationDay;

float _ViralityYoung;
float _ImpactYoung;
float _VisibilityYoung;

float _ViralityAdults;
float _ImpactAdults;
float _VisibilityAdults;

float _ViralitySeniors;
float _ImpactSeniors;
float _VisibilitySeniors;

float _PropagandaDirection;
int _YoungMaxAge;
int _AdultMaxAge;

float Hash(uint s, bool saturate = false)
{
    s += seedValue;
    s = (s ^ 61u) ^ (s >> 16u);
    s *= 9u;
    s = s ^ (s >> 4u);
    s *= 0x27d4eb2du;
    s = s ^ (s >> 15u);
    return saturate ? float(s) / 4294967296.0 : float(s);
}

float NormalizeLevel(float value)
{
    return 1.0 - exp(-max(value, 0.0) * 0.15);
}

void GetAgeBandPropaganda(uint age, out float virality, out float impact, out float visibility)
{
    uint youngMaxAge = (uint)max(_YoungMaxAge, 0);
    uint adultMaxAge = (uint)max(_AdultMaxAge, _YoungMaxAge);

    if (age <= youngMaxAge)
    {
        virality = _ViralityYoung;
        impact = _ImpactYoung;
        visibility = _VisibilityYoung;
    }
    else if (age <= adultMaxAge)
    {
        virality = _ViralityAdults;
        impact = _ImpactAdults;
        visibility = _VisibilityAdults;
    }
    else
    {
        virality = _ViralitySeniors;
        impact = _ImpactSeniors;
        visibility = _VisibilitySeniors;
    }
}
// Load the NPC buffer
Npc LoadNpc(uint index)
{
    uint address = index * 12;
    uint3 data = npcs.Load3(address);
    Npc npc;
    npc.population = int((data.x >> 0) & 0xFF);            // Extract byte 0
    npc.age = (data.x >> 8) & 0xFF;                        // Extract byte 1
    npc.education = (data.x >> 16) & 0xFF;                 // Extract byte 2
    npc.impressionability = (data.x >> 24) & 0xFF;         // Extract byte 3
    npc.stance = int((data.y >> 0) & 0xFF) - 128;          // Extract byte 4
    npc.friendIndex = (data.y >> 8);                       // Extract bytes 5-8 (3 bytes from data.y)
    npc.friendIndex |= (data.z & 0xFF) << 24;              // Extract byte 8 (1 byte from data.z)
    npc.neighbors = (data.z >> 8) & 0xFF;                  // Extract byte 9
    // Bytes 10-11 are padding, ignored
    return npc;
}
// Store the NPC buffer
void StoreNpc(uint index, Npc npc)
{
    uint address = index * 12;
    uint3 data;
    data.x = ((npc.population) & 0xFF) | 
             ((npc.age & 0xFF) << 8) | 
             ((npc.education & 0xFF) << 16) | 
             ((npc.impressionability & 0xFF) << 24);
    data.y = ((npc.stance + 128) & 0xFF) | 
             ((npc.friendIndex & 0xFFFFFF) << 8);                       // Lower 3 bytes of friendIndex in bytes 5-7
    data.z = (npc.friendIndex >> 24) | ((npc.neighbors & 0xFF) << 8);   // Upper byte of friendIndex in byte 8, neighbors in byte 9, bytes 10-11 are padding
    npcs.Store3(address, data);
}

[numthreads(64, 1, 1)]
void SimulationInit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _NumNPCs) return;
    float2 uv = float2(id.x % populationSize.x, id.x / populationSize.x) / float2(populationSize);
    float4 initData = simumlationInitialTexture.Load(int3(uv * imageSize, 0));
    Npc npc = LoadNpc(id.x);
    npc.population = uint((initData.x - 0.05) * 260.0); // somehow normalized to match the texture
    npc.age = uint(initData.y * 255.0);
    npc.education = uint(initData.z * 255.0);
    npc.impressionability = uint(initData.w * 255.0);
    npc.stance = int(pow(saturate(initData.z*0.9 + 0.08 - Hash(id.x+789, true)*0.15), 0.2) * 255 - 128);
    npc.neighbors = uint(npc.population / 255. * 4.5 + Hash(id.x+123, true)*4); // neighbors based by population with 50% randomness
    StoreNpc(id.x, npc);
}

[numthreads(64, 1, 1)]
void SimulationStep(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _NumNPCs) return;
    Npc currentNpc = LoadNpc(id.x);
    if (currentNpc.population == 0u) return;
    Npc friendNpc = LoadNpc(min(currentNpc.friendIndex, _NumNPCs - 1));
    int2 currentNpcPos = int2(id.x % populationSize.x, id.x / populationSize.x);

    float viralityRaw;
    float impactRaw;
    float visibilityRaw;
    GetAgeBandPropaganda(currentNpc.age, viralityRaw, impactRaw, visibilityRaw);
    float virality = NormalizeLevel(viralityRaw);
    float impact = NormalizeLevel(impactRaw);
    float visibility = NormalizeLevel(visibilityRaw);

    // Weighted average current value with neighbors
    float weightedSum = float(currentNpc.stance);
    float totalWeight = 1.0;
    float impressionability = currentNpc.impressionability / 255.0;
    float educationResistance = currentNpc.education / 255.0;
    float susceptibility = saturate(impressionability * (1.2 - 0.8 * educationResistance));

    if (currentNpc.population > 0u && currentNpc.neighbors > 0) {
        uint rngState = (uint)Hash(id.x + uint(_SimulationDay) * 977u);
        int neighborOrder[8] = {0, 1, 2, 3, 4, 5, 6, 7};
        for (int j = 7; j > 0; j--) {
            rngState = rngState * 747796405u + 2891336453u;
            int swapIdx = int((rngState >> 16) % uint(j + 1));
            int temp = neighborOrder[j];
            neighborOrder[j] = neighborOrder[swapIdx];
            neighborOrder[swapIdx] = temp;
        }
        // Use first N neighbors from randomized order
        int numNeighbors = min(currentNpc.neighbors, 8u);
        for (int i = 0; i < numNeighbors; i++) {
            int neighborIdx = neighborOrder[i];  // randomized order
            uint mappedIdx = neighborIdx < 4 ? neighborIdx : neighborIdx + 1;
            int2 neighborPos = currentNpcPos + int2((mappedIdx % 3) - 1, (mappedIdx / 3) - 1);
            if (neighborPos.x < 0 || neighborPos.y < 0 || neighborPos.x >= populationSize.x || neighborPos.y >= populationSize.y) continue;
            uint neighborIndex = neighborPos.y * populationSize.x + neighborPos.x;
            Npc neighborNpc = LoadNpc(neighborIndex);
            if (neighborNpc.population == 0u) continue; // skip non-populated

            float neighborWeight = 0.45 + 0.65 * susceptibility;
            weightedSum += float(neighborNpc.stance) * neighborWeight;
            totalWeight += neighborWeight;
        }
        rngState = rngState * 747796405u + 2891336453u;
        float friendRoll = float(rngState) / 4294967296.0;
        float friendVisibilityChance = saturate(0.05 + visibility * (0.15 + 0.7 * virality));
        if (friendNpc.population > 0u && friendRoll < friendVisibilityChance) {
            float friendWeight = _InternetWeight * (0.1 + 0.9 * virality);
            weightedSum += float(friendNpc.stance) * friendWeight;
            totalWeight += friendWeight;
        }
    }

    // Social update
    float averageValue = weightedSum / max(totalWeight, 1e-5);
    float currentStanceNorm = clamp(float(currentNpc.stance) / 127.0, -1.0, 1.0);
    float averageNorm = clamp(averageValue / 127.0, -1.0, 1.0);
    float socialOpposition = saturate(max(0.0, -currentStanceNorm * averageNorm));
    float conviction = saturate(pow(abs(currentStanceNorm), 1.35));
    float socialInertia = 1.0 - 0.75 * socialOpposition * conviction;
    float socialBlend = lerp(0.04, 0.22, susceptibility) * socialInertia;
    float nextStance = lerp(float(currentNpc.stance), averageValue, socialBlend);

    // Propaganda update
    uint propagandaState = (uint)Hash(id.x + uint(_SimulationDay) * 1597u + 17u);
    float propagandaRoll = float(propagandaState) / 4294967296.0;
    float propagandaExposureChance = saturate(visibility * (0.2 + 0.8 * virality));
    if (propagandaRoll < propagandaExposureChance)
    {
        float propagandaTarget = clamp(_PropagandaDirection, -1.0, 1.0) * 127.0;
        float targetNorm = clamp(_PropagandaDirection, -1.0, 1.0);
        float distanceToTarget = saturate(abs(targetNorm - currentStanceNorm) * 0.5);
        float oppositeSide = saturate(max(0.0, -currentStanceNorm * targetNorm));
        float ideologicalResistance = saturate(1.0 - (0.85 * oppositeSide * conviction + 0.55 * distanceToTarget * conviction));
        float propagandaStrength = impact * susceptibility * (1.0 - 0.6 * educationResistance) * ideologicalResistance;
        float propagandaBlend = saturate(0.02 + propagandaStrength * 0.28);
        nextStance = lerp(nextStance, propagandaTarget, propagandaBlend);
    }

    // Stabilization: cap daily change so high propaganda levels remain controllable
    float maxDailyShift = lerp(2.0, 14.0, saturate(impact * (0.35 + 0.65 * visibility)));
    float clampedDelta = clamp(nextStance - float(currentNpc.stance), -maxDailyShift, maxDailyShift);
    nextStance = float(currentNpc.stance) + clampedDelta;

    currentNpc.stance = clamp(int(round(nextStance)), -128, 127);
    StoreNpc(id.x, currentNpc);
}
